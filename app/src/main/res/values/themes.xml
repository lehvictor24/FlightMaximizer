<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Minimal window theme for a pure-Compose app.
        All Material3 styling is applied via FlightMaximizerTheme (Kotlin/Compose).
        android:Theme.Light.NoTitleBar is a base-framework theme (API 1+) that
        requires no library dependency and is always present in the SDK.
    -->
    <style name="Theme.FlightMaximizer" parent="android:Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
